diff --git a/cmd/lima-guestagent/daemon_linux.go b/cmd/lima-guestagent/daemon_linux.go
index 1002a3cb..c378d542 100644
--- a/cmd/lima-guestagent/daemon_linux.go
+++ b/cmd/lima-guestagent/daemon_linux.go
@@ -7,6 +7,8 @@ import (
 	"errors"
 	"net"
 	"os"
+	"os/signal"
+	"syscall"
 	"time"
 
 	"github.com/mdlayher/vsock"
@@ -54,11 +56,40 @@ func daemonAction(cmd *cobra.Command, _ []string) error {
 	logrus.Infof("event tick: %v", tick)
 
 	newTicker := func() (<-chan time.Time, func()) {
+		sighupC := make(chan os.Signal, 1)  // channel to wait os.Signal
+		signal.Notify(sighupC, syscall.SIGHUP)
+		logrus.Info("register for sighup notifications");
+
 		// TODO: use an equivalent of `bpftrace -e 'tracepoint:syscalls:sys_*_bind { printf("tick\n"); }')`,
 		// without depending on `bpftrace` binary.
 		// The agent binary will need CAP_BPF file cap.
 		ticker := time.NewTicker(tick)
-		return ticker.C, ticker.Stop
+
+		c := make(chan time.Time, 1)
+		go func() {
+			for {
+				select {
+				case <-sighupC:
+					logrus.Debug("Sighup received");
+					c <- time.Now()
+				case now := <-ticker.C:
+					c <- now
+				default:
+					break
+				}
+			}
+			close(c)
+			logrus.Info("ticker stopped");
+		}()
+
+		stop := func() {
+			logrus.Info("stopping ticker");
+			ticker.Stop()
+			signal.Stop(sighupC)
+			close(sighupC)
+		}
+
+		return c, stop
 	}
 
 	agent, err := guestagent.New(newTicker, tick*20)
