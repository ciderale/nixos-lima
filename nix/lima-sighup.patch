+						sighupC = nil
+					} else {
+						logrus.Debug("Sighup received")
+						c <- time.Now()
+					}
+				case now, ok := <-ticker.C:
+					if !ok {
+						ticker.C = nil
+					} else {
+						c <- now
+					}
+				}
+			}
+			logrus.Info("ticker stopped")
+		}()
+
+		stop := func() {
+			logrus.Info("stopping ticker")
